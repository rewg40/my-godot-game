    {
      "type": "code",
      "lang": "gdscript",
      "code": "# Hitscan: raycast от камеры, «визуальный» трассер от ствола\nvar space := get_viewport().world_3d.direct_space_state\nfunc shoot(muzzle: Node3D, spread_deg: float) -> void:\n    var dir := aim_basis * Vector3.RIGHT.rotated(aim_basis, deg_to_rad(spread_deg * randf()))\n    var q := PhysicsRayQueryParameters3D.create(aim_origin, aim_origin + dir * RANGE, MASK_WORLD)\n    var res := space.intersect_ray(q)\n    if res and res.collider.has_method(\"apply_hit\"): res.collider.apply_hit(_make_hit(dmg, dir))\n# Melee: 1 sphere-shape overlap + «scoring» по углу и таймингу, без физики оружия.\n# Recoil: additive анимация + камера-кривая; паттерн = массив (x,y,откат) на 10 выстрелов."
    },
